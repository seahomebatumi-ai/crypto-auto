name: Update Coefficients
on:
  schedule:
    - cron: '0 * * * *'
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'
      - name: Run updater
        env:
          GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
        run: |
          pip install requests
          python main.py
