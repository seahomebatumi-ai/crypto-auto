import json
import requests
import numpy as np
import os
from pycoingecko import CoinGeckoAPI

cg = CoinGeckoAPI()
GIST_ID = '9d8c8acf467c76de582faebd77a91820'
# Токен берется из настроек безопасности (Secrets)
GITHUB_TOKEN = os.environ.get('GIST_TOKEN')

coins = {
    'SUI': 'sui', 'ONDO': 'ondo-finance', 'LINK': 'chainlink', 'RENDER': 'render-token',
    'NEAR': 'near', 'YFI': 'yearn-finance', 'AAVE': 'aave', 'AVAX': 'avalanche-2',
    'FET': 'fetch-ai', 'ENA': 'ethena', 'TAO': 'bittensor', 'TON': 'the-open-network',
    'XRP': 'ripple', 'ADA': 'cardano'
}

def update_gist():
    btc = np.array([x[1] for x in cg.get_coin_market_chart_by_id('bitcoin', 'usd', 30)['prices']])
    coeffs = {}
    for sym, coin_id in coins.items():
        try:
            data = cg.get_coin_market_chart_by_id(id=coin_id, vs_currency='usd', days=30)
            token_prices = np.array([x[1] for x in data['prices']])
            min_len = min(len(btc), len(token_prices))
            b_ret = np.diff(btc[-min_len:]) / btc[-min_len-1:-1]
            p_ret = np.diff(token_prices[-min_len:]) / token_prices[-min_len-1:-1]
            beta = np.cov(p_ret, b_ret)[0,1] / np.var(b_ret)
            coeffs[sym] = round(float(beta), 2)
        except Exception as e:
            print(f"Ошибка при расчете {sym}: {e}")
            coeffs[sym] = 1.0

    url = f'https://api.github.com/gists/{GIST_ID}'
    headers = {'Authorization': f'token {GITHUB_TOKEN}'}
    data = {'files': {'coeffs.json': {'content': json.dumps(coeffs)}}}
    response = requests.patch(url, headers=headers, json=data)
    print(f"Статус обновления: {response.status_code}")

if __name__ == '__main__':
    update_gist()
