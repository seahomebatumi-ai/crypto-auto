+def klines(net, sym, interval, limit):
+    rows = net.json(FAPI + "/fapi/v1/klines?symbol=%s&interval=%s&limit=%d" % (sym, interval, limit))
+    return [(int(r[0]), float(r[1]), float(r[2]), float(r[3]), float(r[4]), int(r[6])) for r in rows]
