+            hits.append("%s **%s** \u00b7 %s \u043e\u0442 $%s \u2192 \u0446\u0435\u043b\u044c \u0432\u0437\u044f\u0442\u0430%s" % (DOT[side], base_name(o["symbol"]), SIDE_RU[side],
+                                                                  score_mod.px(o["entry"]), now))
