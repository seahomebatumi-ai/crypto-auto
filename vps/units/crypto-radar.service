[Unit]
Description=Crypto assistant: the radar, the list coins' publications and the unlock index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryptoauto
Group=cryptoauto
ExecStart=/usr/bin/python3 /srv/crypto-auto/vps/radar.py
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/spool/crypto-auto /var/lib/crypto-auto
MemoryAccounting=yes
MemoryMax=128M
TimeoutStartSec=1800
