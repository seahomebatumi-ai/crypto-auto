[Unit]
Description=Crypto assistant: US spot ETF daily net flows from SoSoValue
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryptoauto
Group=cryptoauto
ExecStart=/usr/bin/python3 /srv/crypto-auto/vps/etf.py
LoadCredential=sosovalue-api-key:/etc/crypto-auto/credentials/sosovalue-api-key
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/crypto-auto
MemoryAccounting=yes
MemoryMax=64M
TimeoutStartSec=300
